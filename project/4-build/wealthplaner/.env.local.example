# Auth.js (NextAuth v5) — Google login (F008)
AUTH_SECRET=run-`npx auth secret`-or-`openssl rand -base64 33`
AUTH_GOOGLE_ID=YOUR-GOOGLE-CLIENT-ID.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=YOUR-GOOGLE-CLIENT-SECRET
AUTH_LINE_ID=YOUR-LINE-CHANNEL-ID
AUTH_LINE_SECRET=YOUR-LINE-CHANNEL-SECRET

# F009 Slip-to-Ledger (CR-WPN-002) — Class B
# LINE Messaging API channel (คนละตัวกับ LINE Login ด้านบน)
LINE_CHANNEL_SECRET=YOUR-LINE-MESSAGING-CHANNEL-SECRET   # ตรวจ x-line-signature
LINE_CHANNEL_ACCESS_TOKEN=YOUR-LINE-MESSAGING-ACCESS-TOKEN  # ดาวน์โหลดรูป + reply
# เปิดใช้ staging เมื่อผูก Cloudflare KV/R2 binding แล้ว (ดู wrangler.toml)
SLIP_STAGING=1
# Google OAuth: เพิ่ม scope drive.file + spreadsheets ใน consent screen (โค้ดขอให้อัตโนมัติ)

# OCR auto-fill (CR-WPN-003) = Tesseract.js รันในเบราว์เซอร์ฝั่งผู้ใช้ — ฟรี ไม่ต้องมีคีย์/env

# ชั้นข้อมูลพอร์ตจริง (F001/F002 · CR-WPN-006) — Supabase · รัน docs/supabase-holdings.sql ก่อน
# Settings → API: Project URL + service_role key (เก็บฝั่งเซิร์ฟเวอร์เท่านั้น อย่าเผยฝั่ง client)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
